# Settings JobPilot reads. On your own computer everything is optional.
# When hosting it online, set DATABASE_URL; the rest stays optional.

# Postgres connection string, e.g. from Neon (neon.tech).
# Leave empty to use the built-in database stored in ~/.jobpilot (fine on your own computer).
DATABASE_URL=

# Encrypts the sign-in cookie (at least 32 characters).
# Leave unset to have one derived from DATABASE_URL or generated.
# SESSION_SECRET=

# Claude reads resumes and suggests preferences. Without a key, a basic keyword
# reader is used instead. Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# The address people open the app at. Used for sign-in redirects; read from the
# request when unset.
# APP_URL=http://localhost:3000

# Optional: "Continue with Google". Create an OAuth client at
# https://console.cloud.google.com/apis/credentials with redirect URI
# ${APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: "Continue with LinkedIn". Create an app at https://www.linkedin.com/developers/apps,
# add the "Sign In with LinkedIn using OpenID Connect" product, and add the redirect URL
# ${APP_URL}/api/auth/linkedin/callback on its Auth tab.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Optional: Adzuna job search API (free key at https://developer.adzuna.com).
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# Two-letter country code Adzuna searches in, e.g. us, gb, in, de.
# Unset: the country of the user's preferred location (US if none is known).
# ADZUNA_COUNTRY=

# Optional: override which company career boards are read.
# Format: ats:board-slug:Company Name, comma separated. ats is greenhouse, lever or ashby.
# JOB_BOARDS=greenhouse:stripe:Stripe,lever:palantir:Palantir,ashby:ramp:Ramp

# Auto-apply: JobPilot fills application forms in Chrome or Edge on the computer running it.
# Path to a Chrome/Chromium binary, if Chrome or Edge isn't found automatically.
# AUTO_APPLY_BROWSER=
# Off by default (test mode: forms are filled but not sent). Set to 1 to really submit.
# AUTO_APPLY_SUBMIT=1
