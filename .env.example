# Copy to .env.local and fill in. Only DATABASE_URL and SESSION_SECRET are required to run locally.

# Postgres connection string. `docker compose up -d` starts one matching this.
DATABASE_URL=postgres://app:app@localhost:5432/recruiter

# Encrypts the sign-in cookie. At least 32 random characters: `openssl rand -base64 32`
SESSION_SECRET=replace-with-at-least-32-random-characters

# Public URL of the app, used for the Google sign-in redirect.
APP_URL=http://localhost:3000

# Claude reads resumes and suggests preferences. Without a key, a basic keyword
# reader is used instead. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: "Continue with Google". Create an OAuth client at
# https://console.cloud.google.com/apis/credentials with redirect URI
# ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Adzuna job search API (free key at https://developer.adzuna.com).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Two-letter country code Adzuna searches in, e.g. us, gb, in, de.
ADZUNA_COUNTRY=us

# Optional: override which company career boards are read.
# Format: ats:board-slug:Company Name, comma separated. ats is greenhouse, lever or ashby.
# JOB_BOARDS=greenhouse:stripe:Stripe,lever:palantir:Palantir,ashby:ramp:Ramp
